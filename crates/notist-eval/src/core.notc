let section = (body: Content) => item("section", (body: body));
let paragraph = (body: Content) => item("paragraph", (body: body));
let heading = (body: Content, level: Int = 1) => item("heading", (level: level, body: body));
let rule = () => item("rule", (:));
let seq = (children: List) => item("seq", (children: children));
let list_item = (body: Content, ordered: Bool = false, number: Int? = ()) => item("list-item", (body: body, ordered: ordered, number: number));
let underline = (body: Content) => item("underline", (body: body));
let strike = (body: Content) => item("strike", (body: body));
let callout = (kind: String = "note", title: Content? = (), body: Content) => if title == () { item("callout", (kind: kind, body: body)) } else { item("callout", (kind: kind, title: title, body: body)) };
let details = (summary: Content? = (), open: Bool = false, body: Content) => if summary == () { item("details", (open: open, body: body)) } else { item("details", (summary: summary, open: open, body: body)) };
let quote = (attribution: Content? = (), body: Content) => if attribution == () { item("quote", (body: body)) } else { item("quote", (attribution: attribution, body: body)) };
let figure = (kind: String = "figure", caption: Content? = (), body: Content) => if caption == () { item("figure", (kind: kind, body: body)) } else { item("figure", (kind: kind, caption: caption, body: body)) };
let image = (source: String, alt: String = "", block: Bool = false) => item("image", (source: source, alt: alt, block: block));
let table_cell = (colspan: Int = 1, rowspan: Int = 1, body: Content) => item("table-cell", (colspan: colspan, rowspan: rowspan, body: body));
let table = (columns: Int, header: Bool = false, align: String? = (), body: Content) => item("table", (columns: columns, header: header, align: align, body: body));
