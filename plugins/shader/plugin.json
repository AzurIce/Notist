{
  "package": "shader",
  "version": "0.1.0",
  "api-version": "0.1",
  "wasm": {
    "module": "semantic.wasm"
  },
  "render": {
    "html": {
      "contributions": [
        {
          "element": "canvas",
          "trusted": true,
          "web-component": {
            "tag": "notist-shader",
            "module": "assets/shader.js",
            "style": "assets/shader.css"
          }
        }
      ]
    }
  }
}
